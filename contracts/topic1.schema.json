{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hacker News message",
  "type": "object",
  "required": ["id", "type", "text", "timestamp"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["story", "comment"]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}